---
// Chapter.astro — un proyecto por pantalla. En pantallas grandes queda fijo y el visual avanza con el scroll
import type { Project } from "../data/portfolio";
import Model3D from "./visuals/Model3D.astro";
import Kernel from "./visuals/Kernel.astro";
import Cipher from "./visuals/Cipher.astro";
import Catalog from "./visuals/Catalog.astro";
import Checkout from "./visuals/Checkout.astro";
import Dashboard from "./visuals/Dashboard.astro";
import Doorbell from "./visuals/Doorbell.astro";
import Recommender from "./visuals/Recommender.astro";
import Argos from "./visuals/Argos.astro";
import Redesign from "./visuals/Redesign.astro";

interface Props {
  p: Project;
  i: number;
  total: number;
}
const { p, i, total } = Astro.props;
const visuals = { model3d: Model3D, kernel: Kernel, cipher: Cipher, catalog: Catalog, checkout: Checkout, dashboard: Dashboard, doorbell: Doorbell, recommender: Recommender, argos: Argos, redesign: Redesign };
const Visual = visuals[p.visual];
const n = String(i + 1).padStart(2, "0");
---

<section
  id={`chapter-${i + 1}`}
  data-scrub="auto"
  data-steps="10"
  data-chapter={n}
  data-nav-label={p.name}
  class={`chapter relative ${p.dark ? "is-dark" : ""}`}
>
  <div class="stage">
    <div class="wrap grid h-full items-center gap-10">
      <div class="lead copy-block">
        <div class="label flex flex-wrap items-center gap-x-3 gap-y-1" data-reveal>
          <span class="!text-signal">{n} / {String(total).padStart(2, "0")}</span>
          <span>{p.discipline}</span>
        </div>
        <h3 class="headline mt-5 !text-[clamp(2rem,3.6vw,3.6rem)]" data-reveal style="--d:.05s">{p.headline}</h3>
        <p class="lede mt-6 max-w-xl" data-reveal style="--d:.1s">{p.desc}</p>
      </div>

      <div class="pin-track">
        <div class="visual-frame" aria-hidden={p.visual === "kernel" ? undefined : "true"}>
          <div class="visual-root"><Visual p={p} /></div>
        </div>
      </div>

      <div class="rest copy-block">
        {
          p.highlights && (
            <ul class="max-w-xl divide-y divide-rule border-y border-rule" data-reveal style="--d:.15s">
              {p.highlights.map((h, j) => (
                <li class="flex gap-4 py-3 text-[0.95rem] leading-snug">
                  <span class="font-mono text-xs text-faint">{String(j + 1).padStart(2, "0")}</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )
        }

        <div class="mt-7 flex flex-wrap items-center gap-2" data-reveal style="--d:.2s">
          {p.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        {
          p.links.length > 0 && (
            <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:.25s">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="btn">
                  {l.label}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* en celular menos aire entre capítulos (antes quedaba mucho blanco) */
  .chapter { padding-block: 3.5rem; }
  .copy-block { min-width: 0; }
  /* el primer elemento de "rest" no suma margen propio: el espaciado lo da el gap de la grilla */
  .rest > :first-child { margin-top: 0; }
  .visual-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 1.75rem;
    overflow: hidden;
    background: var(--color-soft);
    container-type: inline-size;
  }
  /* los visuales usan em: escalan con el ancho del marco (piso más alto para que en celular no queden diminutos) */
  .visual-root { position: absolute; inset: 0; font-size: clamp(16px, 2.6cqw, 22px); }
  /* contenedor del visual: en escritorio es transparente (el visual es celda de la grilla); en celular da la altura para fijarlo */
  .pin-track { position: relative; }

  /* escritorio apaisado: texto a la izquierda (intro arriba, resto abajo) y visual a la derecha, centrado */
  @media (min-width: 64rem) and (orientation: landscape) {
    .wrap {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      grid-template-areas: "lead visual" "rest visual";
      column-gap: 4rem;
      row-gap: 2rem;
      align-content: center;
    }
    .pin-track { display: contents; }
    .lead { grid-area: lead; align-self: end; }
    .rest { grid-area: rest; align-self: start; }
    .visual-frame { grid-area: visual; align-self: center; }
  }

  /* pantallas con lugar: el capítulo dura 3 pantallas y el escenario queda fijo */
  @media (min-width: 64rem) and (min-height: 40rem), (min-width: 48rem) and (min-height: 60rem) {
    .chapter { height: 300vh; padding: 0; }
    .stage { position: sticky; top: 0; height: 100svh; padding-top: 4rem; }
    .visual-frame { max-height: calc(100svh - 9rem); }
  }
  /* tablet vertical: intro → visual → resto apilados y visual más ancho */
  @media (orientation: portrait) and (min-width: 48rem) and (min-height: 60rem) {
    .stage .wrap { align-content: center; }
    .visual-frame { aspect-ratio: 16 / 10; }
  }
  /* viewports bajos (muchas laptops): compactar el texto para que no desborde el escenario fijo y pise el próximo capítulo */
  @media (min-width: 64rem) and (orientation: landscape) and (max-height: 50rem) {
    .stage { padding-top: 3rem; }
    .wrap { row-gap: 1.1rem; }
    .lead .headline { margin-top: 0.5rem; font-size: clamp(1.4rem, 2.8vw, 2.3rem) !important; }
    .lead .lede { margin-top: 0.6rem; font-size: clamp(0.95rem, 1.1vw, 1.05rem) !important; }
    .rest ul li { padding-block: 0.4rem; }
    .rest > .mt-7 { margin-top: 0.9rem; }
    .rest > div:last-child { margin-top: 0.9rem; }
  }
  /* SOLO teléfonos: el visual queda fijo y se anima con el scroll (como en escritorio, pero apilado) */
  @media (max-width: 47.9375rem) {
    .pin-track { height: 140vh; }
    .visual-frame { position: sticky; top: 16vh; aspect-ratio: 1 / 1; }
  }
</style>
